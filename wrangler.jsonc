{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "systems-mapping",
  "account_id": "452c33847cf5cb1e46f391fca32fd1b5",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./dist-cloudflare", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "single-page-application" },
  "durable_objects": { "bindings": [{ "name": "COURSES", "class_name": "MappingCourse" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MappingCourse"] }],
  "services": [
    { "binding": "BUG_REPORTS", "service": "cail-tools-admission", "entrypoint": "AdmissionBugReports", "props": { "app": "systems-mapping", "origins": ["https://systems-mapping.ailab-452.workers.dev"] } },
    { "binding": "ADMISSION_RESOLVER", "service": "cail-tools-admission", "entrypoint": "AdmissionResolver" },
    { "binding": "IDENTITY", "service": "cail-doorway", "entrypoint": "WorkerIdentity", "props": { "id": "systems-mapping", "worker": "systems-mapping", "workspace": false } },
    { "binding": "GATEWAY", "service": "cail-model-api" }
  ],
  "ratelimits": [{ "name": "REQUEST_LIMIT", "namespace_id": "350908", "simple": { "limit": 60, "period": 60 } }],
  "observability": { "enabled": true, "logs": { "invocation_logs": false, "head_sampling_rate": 1 } },
  "vars": {
    "PUBLIC_ORIGIN": "https://systems-mapping.ailab-452.workers.dev",
    "LOGIN_URL": "/auth/start",
    "COURSE_ID": "systems-mapping-default",
    "COURSE_ACCESS_ENABLED": "true",
    "COURSE_IDS": "understanding-systems-impacting-youth-and-families-fall-2026-01,cail-teaching-tools-demo",
    "RELEASE": "ae5ea57-cloudflare-candidate",
    "GATEWAY_MODEL": "glm-5.3-flash",
    "GUIDANCE_CONCURRENCY": "8"
  }
}
