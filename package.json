{
  "name": "systems-mapping-studio",
  "license": "AGPL-3.0-or-later",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "node server/index.js",
    "server": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "db:migrate": "node server/migrate.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:server": "vitest run server",
    "test:e2e": "pnpm build && playwright test",
    "test:a11y": "pnpm build && playwright test tests/e2e/accessibility.spec.js",
    "test:e2e:headed": "pnpm build && playwright test --headed",
    "test:watch": "vitest",
    "build:cloudflare": "VITE_ACCOUNT_WORKSPACE=true vite build --outDir dist-cloudflare",
    "typecheck:cloudflare": "tsc -p cloudflare/tsconfig.json",
    "check:cloudflare": "pnpm typecheck:cloudflare && pnpm build:cloudflare && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "check:cloudflare:dev": "pnpm typecheck:cloudflare && pnpm build:cloudflare && wrangler deploy -c wrangler.dev.jsonc --dry-run --outdir .wrangler/dry-run-dev",
    "deploy:dev": "pnpm build:cloudflare && wrangler deploy -c wrangler.dev.jsonc --var RELEASE:$(git rev-parse HEAD) && node scripts/verify-cloudflare-release.mjs $(git rev-parse HEAD) https://systems-mapping-dev.ailab-452.workers.dev"
  },
  "dependencies": {
    "@cuny-ai-lab/cail-identity": "5.2.6",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@hono/node-server": "2.1.0",
    "@vitejs/plugin-react": "6.0.5",
    "hono": "4.13.7",
    "mammoth": "1.12.0",
    "pdfjs-dist": "6.3.289",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.1",
    "@cuny-ai-lab/cail-client": "6.2.2",
    "@cuny-ai-lab/cail-log": "0.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "^5.20260907.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "^26.5.0",
    "jsdom": "30.0.1",
    "typescript": "^7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.130.0"
  }
}
