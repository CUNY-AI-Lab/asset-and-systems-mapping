# Server-only Ollama Cloud authentication. Never prefix this variable with VITE_.
# Create a fresh key after revoking any key exposed in chat or shell history.
OLLAMA_ENABLED=false
OLLAMA_API_KEY=

# Ollama Cloud direct API endpoint and model. Set OLLAMA_ENABLED=true only after
# installing a fresh server-side key and accepting the source-text egress shown
# to students before evaluation.
OLLAMA_CLOUD_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:20b
