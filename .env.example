# Server-only Ollama Cloud authentication. Never prefix this variable with VITE_.
# Create a fresh key after revoking any key exposed in chat or shell history.
OLLAMA_ENABLED=false
OLLAMA_API_KEY=

# Ollama Cloud direct API endpoint and model. Set OLLAMA_ENABLED=true only after
# installing a fresh server-side key and accepting the source-text egress shown
# to students before evaluation.
OLLAMA_CLOUD_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:20b

# Optional request tuning. Thinking models spend output tokens on reasoning
# before the JSON answer; for the structured memo review contract, disable
# thinking (OLLAMA_THINK=false) — DeepSeek answers in seconds instead of
# minutes. Leave OLLAMA_THINK unset for models that reject the toggle.
#OLLAMA_THINK=false
#OLLAMA_TIMEOUT_MS=90000
#OLLAMA_MAX_OUTPUT_TOKENS=8192

# Server-only OpenRouter runtime. When enabled alongside Ollama Cloud it serves
# as the automatic backup on provider-side failures; enabled alone it is the
# primary runtime. Same key hygiene rules as OLLAMA_API_KEY.
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
#OPENROUTER_REASONING=false
#OPENROUTER_TIMEOUT_MS=90000
#OPENROUTER_MAX_OUTPUT_TOKENS=8192

# Prototype telemetry limit per client per minute (default 60; the e2e server raises it).
#PROTOTYPE_EVENT_LIMIT=60
